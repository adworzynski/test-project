{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "keel://schemas/change.json",
  "title": "Change with a spec delta, Quick or Feature track (AG-3)",
  "allOf": [
    {
      "$ref": "artifact.json"
    }
  ],
  "properties": {
    "type": {
      "const": "change"
    },
    "id": {
      "type": "string",
      "pattern": "^CH-\\d{3,}$"
    },
    "status": {
      "enum": [
        "draft",
        "pending-review",
        "approved",
        "rejected",
        "in-progress",
        "done",
        "archived"
      ]
    },
    "track": {
      "enum": [
        "quick",
        "feature"
      ]
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^AC-\\d{3,}$"
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "route": {
      "type": "object",
      "properties": {
        "track": {
          "enum": [
            "quick",
            "feature"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "override": {
          "type": "boolean"
        }
      }
    },
    "escalations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "reason"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "at": {
            "type": "string"
          }
        }
      }
    },
    "archived": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}"
    }
  }
}
