{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "keel://schemas/constraint.json",
  "title": "Constraint entry in .keel/memory/constraints.md (ME-2)",
  "type": "object",
  "required": [
    "id",
    "title"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^CN-\\d{3,}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string"
    },
    "by": {
      "type": "string"
    },
    "source": {
      "type": "string"
    }
  }
}
