{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "keel://schemas/requirement.json",
  "title": "Requirement section (### FR-001: title [Must])",
  "type": "object",
  "required": [
    "id",
    "title",
    "kind",
    "parent"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^N?FR-\\d{3,}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "FR",
        "NFR"
      ]
    },
    "priority": {
      "enum": [
        "Must",
        "Should",
        "Could",
        "Won't"
      ]
    },
    "parent": {
      "type": "string"
    }
  }
}
