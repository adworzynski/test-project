{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "keel://schemas/workflow.json",
  "title": "Keel workflow (WF-1)",
  "type": "object",
  "required": [
    "id",
    "name",
    "scope",
    "stages"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "scope": {
      "enum": [
        "project",
        "change"
      ]
    },
    "budget": {
      "type": "string"
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "steps"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "name": {
            "type": "string"
          },
          "explain": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/definitions/step"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "step": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "name": {
          "type": "string"
        },
        "skill": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "produces": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          ]
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gate": {
          "enum": [
            "none",
            "approval",
            "evidence",
            "checklist"
          ]
        },
        "done_when": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "foreach": {
          "type": "boolean"
        },
        "optional": {
          "type": "boolean"
        },
        "command": {
          "type": "string"
        },
        "explain": {
          "type": "string"
        },
        "when": {
          "type": "object",
          "properties": {
            "profile": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "planning": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
