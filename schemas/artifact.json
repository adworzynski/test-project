{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "keel://schemas/artifact.json",
  "title": "Keel artifact front-matter (AG-1)",
  "description": "Fields every Keel artifact file carries in its YAML front-matter.",
  "type": "object",
  "required": [
    "id",
    "type",
    "status",
    "links",
    "owner",
    "created",
    "updated"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z]{1,3}-\\d{3,}$"
    },
    "type": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "links": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[A-Z]{1,3}-\\d{3,}$"
        }
      }
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "created": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}"
    },
    "needs_review": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "imported": {
      "type": "boolean"
    }
  }
}
